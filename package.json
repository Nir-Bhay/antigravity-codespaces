{
  "name": "antigravity-codespaces",
  "displayName": "Antigravity Codespaces Pro",
  "description": "Enterprise multi-account GitHub Codespaces manager for Cursor IDE, Antigravity IDE, VS Code & Code-OSS. Connect, start, stop, rebuild, test, and monitor all your cloud dev environments across multiple GitHub accounts with 1 click — by Nirbhay hiwse.",
  "version": "5.3.2",
  "publisher": "nirbhay-hiwse",
  "author": {
    "name": "Nirbhay hiwse",
    "url": "https://github.com/Nir-Bhay"
  },
  "license": "MIT",
  "homepage": "https://github.com/Nir-Bhay/antigravity-codespaces#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nir-Bhay/antigravity-codespaces"
  },
  "bugs": {
    "url": "https://github.com/Nir-Bhay/antigravity-codespaces/issues"
  },
  "keywords": [
    "cursor",
    "cursor-ide",
    "cursor-codespaces",
    "cursor-agent",
    "codespaces",
    "github-codespaces",
    "antigravity",
    "antigravity-ide",
    "remote-development",
    "remote-ssh",
    "ssh",
    "devcontainer",
    "multi-account",
    "windsurf",
    "vscodium",
    "code-oss",
    "open-vsx",
    "vscode",
    "cloud-ide",
    "cloud-dev",
    "ai-agent",
    "ssh-keepalive",
    "websocket-keepalive",
    "port-forwarding",
    "workspace-manager",
    "developer-tools",
    "productivity",
    "docker",
    "container",
    "github"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "icon": "icon.png",
  "scripts": {
    "test": "node test/run.js",
    "check": "node -c extension.js"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:antigravity-codespaces-view"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Antigravity Codespaces",
      "properties": {
        "antigravity-codespaces.autoSyncSSHOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically synchronize Codespaces into ~/.ssh/config on IDE startup."
        },
        "antigravity-codespaces.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Display the Codespaces quick-access badge in the bottom Status Bar."
        },
        "antigravity-codespaces.serverAliveInterval": {
          "type": "number",
          "default": 30,
          "description": "SSH keepalive interval in seconds (prevents WebSocket drops during AI agent sessions)."
        },
        "antigravity-codespaces.serverAliveCountMax": {
          "type": "number",
          "default": 10,
          "description": "Maximum SSH keepalive probes before declaring a connection dead."
        },
        "antigravity-codespaces.defaultRemoteFolder": {
          "type": "string",
          "default": "/workspaces/${repo}",
          "description": "Default remote container folder path when connecting via SSH. Supports ${repo} and ${name} placeholders."
        },
        "antigravity-codespaces.strictHostKeyChecking": {
          "type": "string",
          "enum": ["accept-new", "yes", "no"],
          "default": "accept-new",
          "description": "SSH host key verification mode. 'accept-new' (recommended) accepts new keys and rejects changed keys. 'yes' requires manual verification. 'no' disables verification (insecure).",
          "enumDescriptions": [
            "Accept new host keys automatically, reject if key changes (recommended)",
            "Always verify host keys manually",
            "Disable host key verification (insecure, not recommended)"
          ]
        },
        "antigravity-codespaces.sshLogLevel": {
          "type": "string",
          "enum": ["quiet", "error", "info", "verbose"],
          "default": "error",
          "description": "SSH logging verbosity. 'error' (default) shows only errors. 'quiet' suppresses all output. 'info' and 'verbose' show more details for debugging.",
          "enumDescriptions": [
            "Suppress all SSH diagnostic output",
            "Show only fatal errors (default, recommended)",
            "Show informational messages",
            "Show verbose debugging output"
          ]
        },
        "antigravity-codespaces.usage.plan": {
          "type": "string",
          "enum": ["auto", "free", "pro", "custom"],
          "default": "auto",
          "description": "Plan used for the Codespaces usage quota. 'auto' reads plan.name from GitHub (needs the 'user' scope; falls back to Free).",
          "enumDescriptions": [
            "Detect from your GitHub account",
            "GitHub Free: 120 core-hours and 15 GB-month per month",
            "GitHub Pro: 180 core-hours and 20 GB-month per month",
            "Use usage.monthlyCoreHours and usage.monthlyStorageGb"
          ]
        },
        "antigravity-codespaces.usage.monthlyCoreHours": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "Monthly included core-hours when usage.plan is 'custom'."
        },
        "antigravity-codespaces.usage.alertThresholds": {
          "type": "array",
          "items": { "type": "number", "minimum": 1, "maximum": 100 },
          "default": [75, 90],
          "description": "Show a notification when compute or storage usage crosses these percentages of the included quota (once per month each). Empty list disables alerts."
        },
        "antigravity-codespaces.usage.refreshMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "How often (minutes) to re-fetch usage from the GitHub billing API. GitHub updates the data hourly."
        },
        "antigravity-codespaces.usage.showSidebarLine": {
          "type": "boolean",
          "default": true,
          "description": "Show the compact usage line under the account picker in the sidebar."
        },
        "antigravity-codespaces.usage.preferredUnit": {
          "type": "string",
          "enum": ["core-hours", "dollars"],
          "default": "core-hours",
          "description": "Primary unit for the compute figure in the sidebar and Cloud Hub card."
        },
        "antigravity-codespaces.usage.monthlyStorageGb": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "description": "Monthly included storage (GB-month) when usage.plan is 'custom'."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-codespaces-container",
          "title": "Codespaces",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-codespaces-container": [
        {
          "type": "webview",
          "id": "antigravity-codespaces-view",
          "name": "GitHub Codespaces"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity-codespaces.openDashboard",
        "title": "Open Cloud Hub Dashboard",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "antigravity-codespaces.quickConnect",
        "title": "Quick Connect to Codespace...",
        "icon": "$(play)"
      },
      {
        "command": "antigravity-codespaces.quickMenu",
        "title": "Open Quick Actions Menu",
        "icon": "$(cloud)"
      },
      {
        "command": "antigravity-codespaces.testSSH",
        "title": "Test SSH Connectivity",
        "icon": "$(zap)"
      },
      {
        "command": "antigravity-codespaces.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravity-codespaces.switchAccount",
        "title": "Switch GitHub Account",
        "icon": "$(account)"
      },
      {
        "command": "antigravity-codespaces.createCodespace",
        "title": "Create New Codespace",
        "icon": "$(plus)"
      },
      {
        "command": "antigravity-codespaces.syncAllSSH",
        "title": "Sync SSH Config",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "antigravity-codespaces.connect",
        "title": "Connect",
        "icon": "$(play)"
      },
      {
        "command": "antigravity-codespaces.start",
        "title": "Turn ON",
        "icon": "$(debug-start)"
      },
      {
        "command": "antigravity-codespaces.stop",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "antigravity-codespaces.rebuild",
        "title": "Rebuild Container",
        "icon": "$(symbol-event)"
      },
      {
        "command": "antigravity-codespaces.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "antigravity-codespaces.copySSHCommand",
        "title": "Copy SSH Command",
        "icon": "$(copy)"
      },
      {
        "command": "antigravity-codespaces.deleteCodespace",
        "title": "Delete Codespace",
        "icon": "$(trash)"
      },
      {
        "command": "antigravity-codespaces.openPortUrl",
        "title": "Open Port in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "antigravity-codespaces.loginGitHub",
        "title": "Login to GitHub Account",
        "icon": "$(key)"
      },
      {
        "command": "antigravity-codespaces.setupDoctor",
        "title": "Codespaces: Setup Doctor",
        "icon": "$(checklist)"
      },
      {
        "command": "antigravity-codespaces.reconnectLast",
        "title": "Reconnect to Last Codespace",
        "icon": "$(history)"
      },
      {
        "command": "antigravity-codespaces.refreshUsage",
        "title": "Codespaces: Refresh Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravity-codespaces.usageGrantAccess",
        "title": "Codespaces: Grant Usage Access (user permission)",
        "icon": "$(key)"
      }
    ],
    "keybindings": [
      {
        "command": "antigravity-codespaces.quickConnect",
        "key": "alt+c",
        "mac": "alt+c"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravity-codespaces.openDashboard",
          "when": "view == antigravity-codespaces-view",
          "group": "navigation@1"
        },
        {
          "command": "antigravity-codespaces.createCodespace",
          "when": "view == antigravity-codespaces-view",
          "group": "navigation@2"
        },
        {
          "command": "antigravity-codespaces.switchAccount",
          "when": "view == antigravity-codespaces-view",
          "group": "navigation@3"
        },
        {
          "command": "antigravity-codespaces.refresh",
          "when": "view == antigravity-codespaces-view",
          "group": "navigation@4"
        }
      ]
    }
  },
  "devDependencies": {
    "ovsx": "1.2.0"
  }
}
